    "random": "100 episodes * 400 = 40000; physics/input selection/IO are unmeasured rather than assigned zero cost"
  },
  "equations": {
    "component_minutes": "assumed_call_count * measured_seconds_per_call / 60",
    "mean_seconds_per_call": "operation_summary.total_seconds / operation_summary.count",
    "p95_seconds_per_call": "the measured operation_summary.p95_seconds for each kernel",
    "reserve_scenario": "sum(component_minutes) * 1.30; the extra 30% is an illustrative planning allowance chosen for this review, not a measured overhead bound",
    "no_double_count_of_shared_plans": "shared_after_audit_step already includes three raw ten-action plans, three controller decisions, two forks, chosen-action forecast and continuous next-GRU target; no further plan cost is added for its 120000 calls"
  },
  "conservative_proxy_choices": [
    "The adaptation-like Q-update measurement includes source teacher work and is applied to every Q-update ceiling, including source/scratch stages that do not always need that work.",
    "A full frozen controller call is charged for every training interaction even though training uses a lighter internal actor without the frozen-wrapper checks.",
    "A full prefix16 call is added for every possible actor invalidation; it also includes a current observation already covered by the control proxy, so this intentionally overcounts part of reconstruction work.",
    "A separate ten-action planning call is charged on every training interaction and every other-neural evaluation step, including cold-gate, boundary and world-off steps that often do not plan.",
    "All final episodes are assumed to reach 400 steps, irrespective of early termination."
  ],
